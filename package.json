{
  "name": "triune-memory",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "orchestrator:plan": "node dist/orchestrator.js plan",
    "orchestrator:dispatch": "node dist/orchestrator.js dispatch",
    "orchestrator:check": "node dist/orchestrator.js check",
    "orchestrator:advance": "node dist/orchestrator.js advance",
    "orchestrator:run": "node dist/orchestrator.js run",
    "orchestrator:init": "node dist/orchestrator.js init",
    "orchestrator:enqueue": "node dist/orchestrator.js enqueue",
    "orchestrator:run-once": "node dist/orchestrator.js run-once",
    "orchestrator:status": "node dist/orchestrator.js status",
    "orchestrator:resume": "node dist/orchestrator.js resume",
    "orchestrator:pause": "node dist/orchestrator.js pause",
    "test:smoke": "bash test/orchestrator-smoke.sh",
    "test:waggle-snapshot": "node test/waggle-snapshot-smoke.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.4"
  }
}
