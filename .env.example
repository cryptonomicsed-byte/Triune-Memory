WALRUS_ENDPOINT=
SUI_ENDPOINT=
SEAL_ENDPOINT=
MEMORY_DATA_DIR=./data

# Nostr relay used by triune_bridge.py for NIP-AE engram persistence.
TRIUNE_RELAY=wss://relay.damus.io

# Agent secret key (hex-encoded 32 B secp256k1 scalar, or nsec1... bech32).
# Required by triune_bridge.py in direct-minipae mode.
TRIUNE_NSEC=

# Optional owner pubkey (hex or npub1...). Defaults to the agent's own pubkey
# (self-owned engrams) when unset.
TRIUNE_OWNER=

# Base URL of the minipae HTTP service used when minipae is NOT on PYTHONPATH.
# triune_bridge.py automatically falls back to HTTP when `import minipae`
# fails.  Start the service before running the SSE subscriber or CLI:
#   cd /path/to/minipae && python3 -m minipae.server --port 30174
# Then set this variable or leave it at the default:
MINIPAE_URL=http://localhost:30174
